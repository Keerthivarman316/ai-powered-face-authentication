# Face Authentication configuration
# Copy this file to .env for local development.

FACE_AUTH_API_KEY=replace-with-a-long-random-secret

# Set true only for the browser demo.
# For a production customer API, keep this false and use real client authentication.
PUBLIC_DEMO_MODE=true

# Local development can use false. Production HTTPS should use true.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
